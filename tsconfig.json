{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"checkJs": false,
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"./.svelte-kit/ambient.d.ts",
		"./vite.config.ts",
		"./src/**/*.js",
		"./src/**/*.ts",
		"./src/**/*.svelte",
		"./src/**/*.js",
		"./src/**/*.ts",
		"./src/**/*.svelte",
		"./tests/**/*.js",
		"./tests/**/*.ts",
		"./tests/**/*.svelte",
		"./telegram-bot/**/*.ts"
	],
	"exclude": ["./node_modules/**", "./.svelte-kit/[!ambient.d.ts]**"]
}
